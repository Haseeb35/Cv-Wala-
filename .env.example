# Server-side only. Never put this in a VITE_ variable.
ANTHROPIC_API_KEY=
PORT=8787

# For the iOS/Android builds: the public URL of the deployed server (leave empty for web — it uses /api on the same origin)
VITE_API_URL=

# --- Protecting the AI buttons (all optional) ---
# Your web address(es), comma-separated, if the app is served from a different
# domain than this server. The iOS/Android apps are always allowed.
ALLOWED_ORIGINS=
# Set to 1 when the server runs behind a proxy (Render, Railway, Fly, Nginx),
# so each visitor is counted by their own address. Leave empty otherwise.
TRUST_PROXY=
# AI requests per visitor, and the ceiling for everyone together per day.
AI_PER_MINUTE=5
AI_PER_DAY=40
AI_DAILY_BUDGET=300
